/* ============================================================
   GLOBAL STYLE - DIKOIN LAB
   ============================================================ */

/* === GENERAL BACKGROUND === */
QWidget {
    background-color: #ecf1fd;
    color: #000000;
    font-family: "Segoe UI";
    font-size: 11pt;
}

/* === DEFAULT GROUPBOX === */
QGroupBox {
    background-color: #FFFFFF;
    border-radius: 20px;
    border: 2px solid #C9D6E8;
    padding: 36px 28px 24px 28px;
    font: 600 14pt "Segoe UI";
    margin: 8px 8px;
}

/* === TITLES === */
QGroupBox::title {
    subcontrol-position: top left;
    margin-top: 10px;
    margin-left: 20px;
    color: #0077b6;
    font: 600 14pt "Segoe UI";
    padding-left: 40px;
}

/* ============================================================
   🔹 REAL-TIME MEASUREMENTS PANEL
   ============================================================ */
QGroupBox#group_lecturas {
    background-color: #0077b6;
    border-radius: 20px;
    border: none;
    padding-top: 70px;
    color: #FFFFFF;
}

QGroupBox#group_lecturas::title {
    color: #FFFFFF;
    font: 700 14pt "Segoe UI";
    margin-left: 20px;
    margin-top: 10px;
    padding-left: 50px;
    background-image: url("icons/measures.png");
    background-repeat: no-repeat;
    background-position: left center;
}

/* Text inside the measurements panel */
QGroupBox#group_lecturas QLabel {
    background: transparent;
    color: #FFFFFF;
    font-size: 11pt;
    font-weight: 500;
}

/* ============================================================
   🔹 CONTROL PANEL
   ============================================================ */
QGroupBox#group_control::title {
    color: #0077b6;
    font: 700 14pt "Segoe UI";
    margin-left: 20px;
    margin-top: 10px;
    background-image: url("icons/control.png");
    background-repeat: no-repeat;
    background-position: left center;
    padding-left: 50px;
}

/* ============================================================
   🔹 GRAPH PANEL
   ============================================================ */
QGroupBox#group_grafica::title {
    color: #0077b6;
    font: 700 14pt "Segoe UI";
    margin-left: 20px;
    margin-top: 10px;
    background-image: url("icons/graph.png");
    background-repeat: no-repeat;
    background-position: left center;
    padding-left: 50px;
}

/* ============================================================
   🔹 LOG PANEL (same blue as measurements)
   ============================================================ */
QGroupBox#group_logs {
    background-color: #0077b6;
    border-radius: 20px;
    border: none;
    padding-top: 70px;
    color: #FFFFFF;
}

QGroupBox#group_logs::title {
    color: #FFFFFF;
    font: 700 14pt "Segoe UI";
    margin-left: 20px;
    margin-top: 10px;
    padding-left: 50px;
    background-image: url("icons/logs.png");
    background-repeat: no-repeat;
    background-position: left center;
}

/* Text inside logs */
QGroupBox#group_logs QTextEdit {
    background: #0077b6;
    border: none;
    color: #FFFFFF;
    font-family: Consolas;
    font-size: 11pt;
}

/* ============================================================
   🔹 BUTTONS
   ============================================================ */
QPushButton {
    background-color: #0077b6;
    color: #FFFFFF;
    border: none;
    border-radius: 14px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 11pt;
}

QPushButton:pressed {
    background-color: #005f87;
}

/* ============================================================
   🔹 SLIDERS
   ============================================================ */
QSlider::groove:horizontal {
    height: 8px;
    background: #A5D8FF;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #0077b6;
    border: 2px solid #005f87;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

/* ============================================================
   🔹 SCROLLBARS
   ============================================================ */
QScrollBar:vertical {
    background: #edf2ff;
    border: none;
    width: 14px;
    margin: 6px 4px;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background: #0077b6;
    border-radius: 7px;
    min-height: 30px;
}

QScrollBar:horizontal {
    background: #edf2ff;
    border: none;
    height: 14px;
    margin: 6px;
    border-radius: 7px;
}

QScrollBar::handle:horizontal {
    background: #0077b6;
    border-radius: 7px;
    min-width: 30px;
}
